{
  "name": "dressup-mvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "functions:build": "node functions/build.mjs",
    "firebase:test": "npm run functions:build && node functions/test/prepare.mjs && npx -y firebase-tools@15.37.0 emulators:exec --project demo-dressup --only auth,firestore,storage,functions \"vitest run --config vitest.emulator.config.ts\"",
    "firebase:login": "npx -y firebase-tools@15.37.0 login",
    "firebase:key": "npx -y firebase-tools@15.37.0 functions:secrets:set GEMINI_API_KEY",
    "firebase:deploy": "npm --prefix functions ci && npx -y firebase-tools@15.37.0 deploy --only functions,firestore,storage",
    "firebase:logs": "npx -y firebase-tools@15.37.0 functions:log --lines 60",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "content:migrate": "tsx tools/content/migrate-preset.ts",
    "studio": "vite --config vite.studio.config.ts",
    "content:fix": "tsx tools/content/fixContent.ts"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "jsqr": "^1.4.0",
    "pixi.js": "^8.14.3",
    "qrcode-generator": "^1.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.16",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.8",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "sharp": "^0.34.5",
    "stripe": "23.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  }
}

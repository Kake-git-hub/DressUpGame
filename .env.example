# スタジオ（npm run studio）の設定の見本
# このファイルを「.env.local」という名前でコピーし、= の右にキーを貼り付ける。
# .env.local は git に入らない。キーを .env.example のほうに書かないこと。

# Claude API のキー（https://platform.claude.com/ で作る。sk-ant- で始まる）
ANTHROPIC_API_KEY=

# Gemini API のキー（https://aistudio.google.com/apikey で作る）
GEMINI_API_KEY=

# 素材フォルダの場所（DressUpGame の隣に DressUpGame-content があれば不要）
# CONTENT_DIR=../DressUpGame-content

# 画像生成の上限（1 日 / 1 回の実行）
# STUDIO_DAILY_IMAGE_LIMIT=60
# STUDIO_RUN_IMAGE_LIMIT=30

# 画像の大きさ（1K / 2K / 4K）。大きいほど高い。既定は 1K（ドールの画像は 1024px）
# STUDIO_GEMINI_IMAGE_SIZE=1K

# 1 品目あたりの生成回数（作り直しを含む、1〜3）。既定は 1 = 自動の作り直しなし
# （画像 AI に内容の決まりで断られたときだけは、説明文を書き直して 1 回やり直す）
# STUDIO_MAX_ATTEMPTS=1
